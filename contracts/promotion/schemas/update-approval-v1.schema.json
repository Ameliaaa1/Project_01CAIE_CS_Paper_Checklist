{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperlens:update-approval:1",
  "title": "PaperLens Update Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "reviewer", "reviewedAt", "requestPath", "requestSha256", "requestId", "currentProductionArtifactSha256", "candidateArtifactSha256", "targetArtifactSha256", "sourceCommit", "approvedDifferences"],
  "properties": {
    "schemaVersion": {"const": 1},
    "decision": {"enum": ["APPROVE", "REJECT"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "requestPath": {"type": "string", "minLength": 1},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "requestId": {"type": "string", "minLength": 1},
    "currentProductionArtifactSha256": {"$ref": "#/$defs/sha256"},
    "candidateArtifactSha256": {"$ref": "#/$defs/sha256"},
    "targetArtifactSha256": {"$ref": "#/$defs/sha256"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approvedDifferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaChange", "scopeChange"],
      "properties": {
        "schemaChange": {"type": "boolean"},
        "scopeChange": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
