{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperlens:bootstrap-approval:1",
  "title": "PaperLens Bootstrap Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "reviewer", "reviewedAt", "promotionId", "candidateArtifactSha256", "targetArtifactSha256", "sourceCommit"],
  "properties": {
    "schemaVersion": {"const": 1},
    "decision": {"enum": ["APPROVE", "REJECT"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "promotionId": {"type": "string", "minLength": 1},
    "candidateArtifactSha256": {"$ref": "#/$defs/sha256"},
    "targetArtifactSha256": {"$ref": "#/$defs/sha256"},
    "sourceCommit": {"$ref": "#/$defs/fullCommit"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fullCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
