{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperlens:question-corpus:1",
  "title": "PaperLens Question Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stableId", "syllabus"],
        "properties": {
          "stableId": {"type": "string", "minLength": 1},
          "syllabus": {"enum": ["0478", "9618"]}
        },
        "additionalProperties": true
      }
    }
  }
}
