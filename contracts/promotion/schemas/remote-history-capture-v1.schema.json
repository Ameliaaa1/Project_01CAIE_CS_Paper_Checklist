{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperlens.local/schemas/remote-history-capture-v1.schema.json",
  "title": "PaperLens Remote History Capture V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceType", "repositoryIdentity", "remoteURL", "remoteBranch", "remoteCommitSHA", "captureTimestamp", "captureMethod", "localTrackingRef", "localTrackingRefSHA", "verificationResult"],
  "properties": {
    "schemaVersion": {"const": 1},
    "evidenceType": {"const": "REMOTE_HISTORY_CAPTURE_V1"},
    "repositoryIdentity": {"type": "string", "minLength": 1},
    "remoteURL": {"type": "string", "format": "uri"},
    "remoteBranch": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
    "remoteCommitSHA": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "captureTimestamp": {"type": "string", "format": "date-time"},
    "captureMethod": {"const": "git ls-remote origin refs/heads/main"},
    "localTrackingRef": {"const": "refs/remotes/origin/main"},
    "localTrackingRefSHA": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verificationResult": {"const": "PASS"}
  }
}
