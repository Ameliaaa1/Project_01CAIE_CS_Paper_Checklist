{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperlens:update-difference-request:1",
  "title": "PaperLens Update Difference Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "currentProductionArtifactSha256", "candidateArtifactSha256", "targetArtifactSha256", "schemaChange", "scopeChange", "sourceCommit", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1},
    "currentProductionArtifactSha256": {"$ref": "#/$defs/sha256"},
    "candidateArtifactSha256": {"$ref": "#/$defs/sha256"},
    "targetArtifactSha256": {"$ref": "#/$defs/sha256"},
    "schemaChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/schemaIdentity"},
        "to": {"$ref": "#/$defs/schemaIdentity"}
      }
    },
    "scopeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "added", "removed"],
      "properties": {
        "from": {"$ref": "#/$defs/syllabusSet"},
        "to": {"$ref": "#/$defs/syllabusSet"},
        "added": {"$ref": "#/$defs/syllabusSet"},
        "removed": {"$ref": "#/$defs/syllabusSet"}
      }
    },
    "sourceCommit": {"$ref": "#/$defs/fullCommit"},
    "createdAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fullCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "syllabusSet": {"type": "array", "uniqueItems": true, "items": {"enum": ["0478", "9618"]}},
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
