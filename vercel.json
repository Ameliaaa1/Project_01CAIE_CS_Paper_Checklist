{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 0; else exit 1; fi",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{public/assets/paperlens-data.js,generated/production-question-index.json,public/textbook_syllabus/pastpaper/**/*.pdf}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
